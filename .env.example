# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Optional. The demo reads the bundled SQLite file prisma/demo.db; set this
# only to point at another SQLite/libSQL database (file:... or libsql://...).
DATABASE_URL=

# Signs the session JWT. Generate with: openssl rand -base64 32
# There is no fallback — the app refuses to start without it.
AUTH_SECRET=
